<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Calendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Calendar.App.Controls"
    xmlns:vm="using:Calendar.App.ViewModels"
    Title="Calendar">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (Mica): sidebar toggle, app title, week navigation; empty space stays draggable. -->
        <TitleBar x:Name="AppTitleBar"
                  Title="Calendar"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.Resources>
                <!-- The default template centers Content, so the buttons moved when the label width changed. -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE787;" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <!-- Left-aligned so a longer label grows to the right instead of shifting the buttons. -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Content="Hôm nay"
                            Command="{x:Bind ViewModel.GoToTodayCommand}"
                            Margin="12,0,8,0" />
                    <Button Command="{x:Bind ViewModel.PreviousCommand}"
                            ToolTipService.ToolTip="Tuần trước"
                            AutomationProperties.Name="Tuần trước"
                            Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.NextCommand}"
                            ToolTipService.ToolTip="Tuần sau"
                            AutomationProperties.Name="Tuần sau"
                            Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,2" />
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <InfoBar Grid.Row="1"
                 Margin="8,0,8,4"
                 IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <SplitView x:Name="Shell"
                   Grid.Row="2"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="260"
                   PaneBackground="Transparent">

            <!-- Sidebar: account → calendars, add account. -->
            <SplitView.Pane>
                <Grid Padding="12,4,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Chưa có tài khoản nào."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.HasNoAccounts, Mode=OneWay}" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccountGroupViewModel">
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Email}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTipService.ToolTip="{x:Bind Email}" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Padding="6,4"
                                                        ToolTipService.ToolTip="Tuỳ chọn tài khoản"
                                                        AutomationProperties.Name="Tuỳ chọn tài khoản">
                                                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuFlyoutItem Text="Xoá tài khoản…"
                                                                            Tag="{x:Bind}"
                                                                            Click="OnRemoveAccountClick">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{x:Bind Calendars}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                                        <Grid ColumnSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                      MinWidth="0">
                                                                <TextBlock Text="{x:Bind Name}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                                            </CheckBox>

                                                            <!-- Color dot: opens the palette. -->
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource SubtleButtonStyle}"
                                                                    Padding="6"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="Đổi màu"
                                                                    AutomationProperties.Name="Đổi màu">
                                                                <Ellipse Width="12" Height="12">
                                                                    <Ellipse.Fill>
                                                                        <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <Button.Flyout>
                                                                    <Flyout Placement="Right">
                                                                        <ItemsControl ItemsSource="{x:Bind Swatches}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <VariableSizedWrapGrid Orientation="Horizontal"
                                                                                                           MaximumRowsOrColumns="6" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:ColorSwatchViewModel">
                                                                                    <Button Command="{x:Bind Select}"
                                                                                            Click="OnSwatchClick"
                                                                                            Style="{StaticResource SubtleButtonStyle}"
                                                                                            Padding="4"
                                                                                            Margin="2"
                                                                                            ToolTipService.ToolTip="{x:Bind Name}"
                                                                                            AutomationProperties.Name="{x:Bind Name}">
                                                                                        <Ellipse Width="20" Height="20">
                                                                                            <Ellipse.Fill>
                                                                                                <SolidColorBrush Color="{x:Bind Color}" />
                                                                                            </Ellipse.Fill>
                                                                                        </Ellipse>
                                                                                    </Button>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.AddAccountCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                    ToolTipService.ToolTip="Đăng nhập tài khoản Google">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Thêm tài khoản" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Width="18" Height="18" />
                        </StackPanel>
                        <Button Content="Huỷ đăng nhập"
                                Command="{x:Bind ViewModel.AddAccountCancelCommand}"
                                Visibility="{x:Bind ViewModel.AddAccountCommand.IsRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <controls:WeekGrid Margin="0,0,8,0"
                               StartDate="{x:Bind ViewModel.StartDate, Mode=OneWay}"
                               Days="{x:Bind ViewModel.Days}"
                               Calendars="{x:Bind ViewModel.Calendars, Mode=OneWay}"
                               Events="{x:Bind ViewModel.Events, Mode=OneWay}" />
        </SplitView>
    </Grid>
</Window>
